<Window x:Class="EveIndustryPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eve Industry Planner"
        Width="1240"
        Height="780"
        MinWidth="1020"
        MinHeight="640"
        Background="#f3f4f6">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#d8dee8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Eve Industry Planner"
                       FontSize="24"
                       FontWeight="SemiBold"
                       DockPanel.Dock="Left" />
            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Right"
                       Foreground="#526176"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedWorkspaceTab}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem Header="Manufacturing">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Blueprints"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <Button Content="Search"
                                        Command="{Binding SearchCommand}"
                                        DockPanel.Dock="Right"
                                        Margin="8,0,0,0" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Blueprints}"
                                     SelectedItem="{Binding SelectedBlueprint}"
                                     BorderBrush="#d8dee8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,6">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BlueprintName}" Foreground="#526176" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ScrollViewer Grid.Row="3"
                                          Margin="0,12,0,0"
                                          MaxHeight="320"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Runs" FontSize="12" Foreground="#526176" />
                                            <TextBox Text="{Binding Runs, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="ME" FontSize="12" Foreground="#526176" />
                                            <TextBox Text="{Binding MaterialEfficiency, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TE" FontSize="12" Foreground="#526176" />
                                            <TextBox Text="{Binding TimeEfficiency, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Additional Costs" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding AdditionalCosts, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                                    </StackPanel>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Buy Materials At" FontSize="12" Foreground="#526176" />
                                            <ComboBox ItemsSource="{Binding MarketLocations}"
                                                      SelectedItem="{Binding SelectedMaterialMarket}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Material Price" FontSize="12" Foreground="#526176" />
                                            <ComboBox ItemsSource="{Binding MaterialPriceStrategies}"
                                                      SelectedItem="{Binding SelectedMaterialPriceStrategy}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Sell Product At" FontSize="12" Foreground="#526176" />
                                            <ComboBox ItemsSource="{Binding MarketLocations}"
                                                      SelectedItem="{Binding SelectedProductMarket}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Product Price" FontSize="12" Foreground="#526176" />
                                            <ComboBox ItemsSource="{Binding ProductPriceStrategies}"
                                                      SelectedItem="{Binding SelectedProductPriceStrategy}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Build / Buy"
                                              IsChecked="{Binding EnableBuildBuy}"
                                              Margin="0,12,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Build Depth" FontSize="12" Foreground="#526176" />
                                            <ComboBox ItemsSource="{Binding BuildBuyDepthOptions}"
                                                      SelectedItem="{Binding SelectedBuildBuyDepth}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Max Depth" FontSize="12" Foreground="#526176" />
                                            <TextBox Text="{Binding MaxBuildBuyDepth, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Facility Assignments" FontWeight="SemiBold" Margin="0,14,0,6" />
                                    <TextBlock Text="{Binding SelectedFinalProductFacilityText}" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedComponentFacilityText}" FontSize="12" Foreground="#526176" />
                                    <TextBlock Text="{Binding SelectedReactionFacilityText}" FontSize="12" Foreground="#526176" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="190" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Columns="4" Rows="3" Margin="0,0,18,0">
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="Output" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding OutputText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="Material Cost" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding MaterialCostText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="Job Cost" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding JobCostText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="Additional Costs" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding AdditionalCostsText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Total Cost" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding TotalCostText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Revenue" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding RevenueText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Profit" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding ProfitText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Margin" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding ProfitPercentText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ISK / Hour" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding IskPerHourText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Total Time" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding ProductionTimeText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Final Time" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding FinalProductionTimeText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="TE Formula" Foreground="#526176" FontSize="12" />
                                        <TextBlock Text="{Binding EffectiveFinalTimeMultiplierText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Calculate"
                                            Width="130"
                                            Command="{Binding CalculateCommand}" />
                                    <Button Content="Add to Production"
                                            Width="130"
                                            Margin="0,8,0,0"
                                            Command="{Binding AddToProductionCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Materials" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Materials}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N0}" Width="100" />
                                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=N2}" Width="130" />
                                        <DataGridTextColumn Header="Volume" Binding="{Binding TotalVolume, StringFormat=N2}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Shopping List" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <Button Content="Copy"
                                                Width="80"
                                                HorizontalAlignment="Right"
                                                Command="{Binding CopyShoppingListCommand}" />
                                    </DockPanel>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding ShoppingListText, Mode=OneWay}"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Breakdown" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding CalculationBreakdownText, Mode=OneWay}"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Production Ledger">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Production Jobs" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProductionLedgerSummaryText}"
                                           Foreground="#526176"
                                           FontSize="12"
                                           Margin="0,4,0,10" />
                            </StackPanel>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ProductionLedgerEntries}"
                                     SelectedItem="{Binding SelectedProductionLedgerEntry}"
                                     BorderBrush="#d8dee8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,6">
                                            <TextBlock Text="{Binding OutputText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SummaryText}" Foreground="#526176" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
                                <Button Content="Remove"
                                        Margin="0,0,6,6"
                                        Command="{Binding RemoveProductionEntryCommand}" />
                                <Button Content="Clear"
                                        Margin="6,0,0,6"
                                        Command="{Binding ClearProductionLedgerCommand}" />
                                <Button Content="Save JSON"
                                        Margin="0,6,6,0"
                                        Command="{Binding SaveProductionLedgerCommand}" />
                                <Button Content="Load JSON"
                                        Margin="6,6,0,0"
                                        Command="{Binding LoadProductionLedgerCommand}" />
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Scope" FontSize="12" Foreground="#526176" />
                                        <ComboBox ItemsSource="{Binding ProductionPlannerScopes}"
                                                  SelectedItem="{Binding SelectedProductionPlannerScope}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Filter" FontSize="12" Foreground="#526176" />
                                        <ComboBox ItemsSource="{Binding ProductionJobFilters}"
                                                  SelectedItem="{Binding SelectedProductionJobFilter}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Mfg Max h/job" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding MaxManufacturingJobHours, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock Text="Reaction Max h/job" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding MaxReactionJobHours, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                        <TextBlock Text="Parallel Mfg Jobs" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding MaxParallelManufacturingJobs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" Margin="0,0,10,0">
                                        <TextBlock Text="Parallel Reactions" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding MaxParallelReactionJobs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="6"
                                            Content="Recalculate Plan"
                                            Command="{Binding RecalculateProductionPlanCommand}"
                                            VerticalAlignment="Bottom" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ProductionJobPlanSummaryText}"
                                           Foreground="#526176"
                                           Margin="0,8,0,8" />

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding ProductionJobPlanRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        <DataGridTextColumn Header="Wave" Binding="{Binding WaveLabel}" IsReadOnly="True" Width="80" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceProductName}" IsReadOnly="True" Width="130" />
                                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Activity" Binding="{Binding ActivityName}" IsReadOnly="True" Width="105" />
                                        <DataGridTextColumn Header="Facility" Binding="{Binding FacilityName}" IsReadOnly="True" Width="130" />
                                        <DataGridTextColumn Header="Needed" Binding="{Binding RequiredQuantity, StringFormat=N0}" IsReadOnly="True" Width="90" />
                                        <DataGridTextColumn Header="Out/Run" Binding="{Binding OutputQuantityPerRun, StringFormat=N0}" IsReadOnly="True" Width="80" />
                                        <DataGridTextColumn Header="Total Runs" Binding="{Binding TotalRuns, StringFormat=N0}" IsReadOnly="True" Width="90" />
                                        <DataGridTextColumn Header="Job" Binding="{Binding JobLabel}" IsReadOnly="True" Width="70" />
                                        <DataGridTextColumn Header="Runs/Job" Binding="{Binding Runs, StringFormat=N0}" IsReadOnly="True" Width="85" />
                                        <DataGridTextColumn Header="Time/Run" Binding="{Binding TimePerRunText}" IsReadOnly="True" Width="90" />
                                        <DataGridTextColumn Header="Job Time" Binding="{Binding DurationText}" IsReadOnly="True" Width="95" />
                                        <DataGridTextColumn Header="Parent" Binding="{Binding ParentProductName}" IsReadOnly="True" Width="120" />
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Combined Materials" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding ProductionLedgerMaterials}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N0}" Width="110" />
                                            <DataGridTextColumn Header="Estimated Cost" Binding="{Binding EstimatedCost, StringFormat=N2}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Combined Shopping List" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <Button Content="Copy"
                                                Width="80"
                                                HorizontalAlignment="Right"
                                                Command="{Binding CopyProductionShoppingListCommand}" />
                                    </DockPanel>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding ProductionLedgerShoppingListText, Mode=OneWay}"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Facilities">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="Facility Assignments" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="Final Product" FontSize="12" Foreground="#526176" />
                            <ComboBox ItemsSource="{Binding FacilityProfiles}"
                                      SelectedItem="{Binding SelectedFinalProductFacility}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="Components" FontSize="12" Foreground="#526176" />
                            <ComboBox ItemsSource="{Binding FacilityProfiles}"
                                      SelectedItem="{Binding SelectedComponentFacility}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="Reactions" FontSize="12" Foreground="#526176" />
                            <ComboBox ItemsSource="{Binding FacilityProfiles}"
                                      SelectedItem="{Binding SelectedReactionFacility}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,14" />

                            <TextBlock Text="Saved Facilities" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <ListBox ItemsSource="{Binding FacilityProfiles}"
                                     SelectedItem="{Binding SelectedEditableFacility}"
                                     DisplayMemberPath="DisplayName"
                                     MinHeight="260"
                                     BorderBrush="#d8dee8" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Content="New"
                                        Command="{Binding NewFacilityCommand}"
                                        Margin="0,0,5,0" />
                                <Button Content="Delete"
                                        Command="{Binding DeleteFacilityCommand}"
                                        Margin="5,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720">
                                <TextBlock Text="Facility Editor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBox Text="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="System Search" FontSize="12" Foreground="#526176" Margin="0,10,0,0" />
                                <DockPanel>
                                    <Button Content="Search"
                                            Command="{Binding SearchSolarSystemsCommand}"
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0" />
                                    <TextBox Text="{Binding SolarSystemSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding SolarSystemResults}"
                                         SelectedItem="{Binding SelectedSolarSystem}"
                                         DisplayMemberPath="DisplayName"
                                         Height="110"
                                         Margin="0,6,0,0"
                                         BorderBrush="#d8dee8" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Selected System" FontSize="12" Foreground="#526176" />
                                        <TextBlock Text="{Binding FacilitySolarSystemName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="System ID" FontSize="12" Foreground="#526176" />
                                        <TextBlock Text="{Binding FacilitySolarSystemId}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Structure" FontSize="12" Foreground="#526176" />
                                    <ComboBox ItemsSource="{Binding FacilityStructures}"
                                              SelectedItem="{Binding SelectedFacilityStructure}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cost Index Activity" FontSize="12" Foreground="#526176" />
                                        <ComboBox ItemsSource="{Binding CostIndexActivities}"
                                                  SelectedItem="{Binding SelectedFacilityService}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Security" FontSize="12" Foreground="#526176" />
                                        <ComboBox ItemsSource="{Binding FacilitySecurityBands}"
                                                  SelectedItem="{Binding SelectedFacilitySecurity}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Installed Services" FontSize="12" Foreground="#526176" Margin="0,12,0,0" />
                                <UniformGrid Columns="2">
                                    <CheckBox Content="Manufacturing Plant"
                                              IsChecked="{Binding HasManufacturingPlant}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Capital Shipyard"
                                              IsChecked="{Binding HasCapitalShipyard}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Supercapital Shipyard"
                                              IsChecked="{Binding HasSupercapitalShipyard}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Composite Reactor"
                                              IsChecked="{Binding HasCompositeReactor}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Hybrid Reactor"
                                              IsChecked="{Binding HasHybridReactor}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Biochemical Reactor"
                                              IsChecked="{Binding HasBiochemicalReactor}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Invention Lab"
                                              IsChecked="{Binding HasInventionLab}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Research Lab"
                                              IsChecked="{Binding HasResearchLab}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Hyasyoda Research Lab"
                                              IsChecked="{Binding HasHyasyodaResearchLab}"
                                              Margin="0,2,8,2" />
                                    <CheckBox Content="Reprocessing Facility"
                                              IsChecked="{Binding HasReprocessingFacility}"
                                              Margin="0,2,8,2" />
                                </UniformGrid>

                                <TextBlock Text="{Binding FacilityRigSlotSummary}" FontSize="12" Foreground="#526176" Margin="0,12,0,0" />
                                <ComboBox ItemsSource="{Binding FacilityRigs}"
                                          SelectedItem="{Binding SelectedFacilityRigSlot1}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding IsFacilityRigSlot1Enabled}" />
                                <ComboBox ItemsSource="{Binding FacilityRigs}"
                                          SelectedItem="{Binding SelectedFacilityRigSlot2}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding IsFacilityRigSlot2Enabled}"
                                          Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding FacilityRigs}"
                                          SelectedItem="{Binding SelectedFacilityRigSlot3}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding IsFacilityRigSlot3Enabled}"
                                          Margin="0,6,0,0" />

                                <Border Background="#f8fafc"
                                        BorderBrush="#d8dee8"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Calculated Multipliers" FontSize="12" Foreground="#526176" />
                                        <TextBlock Text="{Binding FacilityMultiplierSummary}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cost Index" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding FacilitySystemCostIndex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Facility Tax" FontSize="12" Foreground="#526176" />
                                        <TextBox Text="{Binding FacilityTaxRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,6,0,0">
                                    <Button Content="Refresh Index"
                                            Command="{Binding RefreshCostIndexCommand}"
                                            DockPanel.Dock="Right"
                                            Width="120"
                                            Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding FacilityCostIndexStatus}"
                                               Foreground="#526176"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <UniformGrid Columns="2" Width="290" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <Button Content="Save Facility"
                                            Command="{Binding SaveFacilityCommand}"
                                            Margin="0,0,5,0" />
                                    <Button Content="Delete"
                                            Command="{Binding DeleteFacilityCommand}"
                                            Margin="5,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="MVP uses local SDE data, Fuzzworks prices, and local settings."
                   Foreground="#526176"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
