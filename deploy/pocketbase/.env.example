# Prefer a pinned tag after verifying the deployment. Use latest only for first experiments.
PB_VERSION=latest
POCKETBASE_PORT=8090
TZ=Europe/Prague

PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# PocketBase settings encryption key. Use a stable 32-character value and keep it secret.
POCKETBASE_ENCRYPTION_KEY=

# Register an EVE Online app and use a redirect URL that points back to the desktop app
# or to the future PocketBase EVE SSO callback endpoint.
EVE_SSO_CLIENT_ID=
EVE_SSO_CLIENT_SECRET=
EVE_SSO_REDIRECT_URI=http://localhost:8080/callback/

# Future token encryption key for ESI refresh token storage.
# Generate a long random value and do not commit the real value.
TOKEN_ENCRYPTION_KEY=
